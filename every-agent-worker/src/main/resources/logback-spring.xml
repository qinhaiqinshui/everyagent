<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      CONSOLE appender 本地定义(不复用 Spring Boot console-appender.xml),经 ThresholdFilter
      由 worker.console-log-threshold 门控,默认 OFF(完全静默):
      desktop 打包版把 worker 进程 stdout/stderr 重定向进 ~/.everyagent/logs/worker.out.log
      且永不轮转,CONSOLE 若保持开启,每条日志会与 worker.log 双份落盘、该文件无限膨胀
      (2026-10 实测 5 周 313MB)。正式日志通道是下方 FILE(每日滚动、保留 7 天)。
      - dev profile(application-dev.yml)置 INFO,IDE 运行恢复控制台输出;
      - 打包环境临时排障:启动参数 -Dworker.console-log-threshold=INFO;
      - JVM 原生崩溃输出(hs_err/OutOfMemoryError 到 stderr)不经本配置,仍落
        worker.out.log 兜底——正常情况下该文件保持近零大小,仅作崩溃现场证据。
      ThresholdFilter 取 OFF 时任何事件级别都达不到门槛 → 全部 DENY,stdout 零输出。
    -->
    <springProperty name="EA_CONSOLE_THRESHOLD" source="worker.console-log-threshold" defaultValue="OFF"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${EA_CONSOLE_THRESHOLD}</level>
        </filter>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>


    <!--
      日志目录解析链(优先级从高到低):
        1. EVERYAGENT_HOME 环境变量(桌面版主进程注入);
        2. worker.home-dir 配置(dev profile = ~/.everyagent-dev;IDE 直接运行不再误落正式目录);
        3. ~/.everyagent 兜底。
      注意 worker.home-dir 须非空(application.yml 默认值已收敛为 ${EVERYAGENT_HOME:${user.home}/.everyagent},
      与 resolveHomeDir 的空值回退语义一致)。
    -->
    <springProperty name="EA_HOME_FROM_CONFIG" source="worker.home-dir" defaultValue="${user.home}/.everyagent"/>
    <property name="EA_LOG_DIR" value="${EVERYAGENT_HOME:-${EA_HOME_FROM_CONFIG}}/logs"/>

    <!-- 主日志:worker 运行日志(含 INFO/DEBUG),每日滚动,保留 7 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${EA_LOG_DIR}/worker.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${EA_LOG_DIR}/worker.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      AI 安全审议审计日志(独立文件):
      - 只承载 dev.everyagent.plugin.aireview.AiAuthReviewer 的审计数据(decision/confidence/reason/grantKey/prompt...)
      - 默认目录 <EVERYAGENT_HOME>/logs,可用环境变量 AUTH_REVIEW_LOG_DIR 覆盖
      - 每天一个文件(auth-review.<yyyy-MM-dd>.log),最多保留 7 天(maxHistory=7)
    -->
    <property name="AUTH_REVIEW_LOG_DIR" value="${AUTH_REVIEW_LOG_DIR:-${EA_LOG_DIR}}"/>

    <appender name="AUTH_REVIEW" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AUTH_REVIEW_LOG_DIR}/auth-review.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${AUTH_REVIEW_LOG_DIR}/auth-review.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 审计数据专用 logger:级别 DEBUG,additivity=false 只写独立文件,不冒泡到 root -->
    <logger name="dev.everyagent.plugin.aireview.AiAuthReviewer" level="DEBUG" additivity="false">
        <appender-ref ref="AUTH_REVIEW"/>
    </logger>

    <!--
      Spring AI MessageAggregator 在 reactive 链每层 onErrorResume 包装处都打印
      ERROR + 完整堆栈，导致同一根因被重复打印 5-6 次（日志污染）。
      我们的 TaskManager + AgentRunner 已通过 RootCause.summary(e) 做了正确的
      一行摘要(error) + 完整堆栈(debug) 日志，此处压制框架重复日志。
    -->
    <logger name="org.springframework.ai.chat.model.MessageAggregator" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
