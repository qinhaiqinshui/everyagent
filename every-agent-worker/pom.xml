<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.everyagent</groupId>
        <artifactId>every-agent-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <version>1.0.0</version>
    <artifactId>every-agent-worker</artifactId>
    <name>every-agent-worker</name>
    <description>worker 执行器:托管任务运行时、workspace、模型配置(6102 仅本地管理)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- streaming(Reactive 栈)是 ChatClient.stream 的前置要求 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- OpenAI 兼容 ChatModel(按 ModelConfig 动态构建,覆盖 deepseek/qwen/glm 等) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- 内嵌终端 PTY 引擎(§7.18):JetBrains pty4j,自带全部平台原生库(Linux .so / macOS .dylib / Windows .dll) -->
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>0.13.10</version>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-plugin-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-hub</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- EditResendRoundsTest 集成验证编辑重发(功能已迁入 task-edit-resend 插件,测试内等价注册其节点) -->
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>task-edit-resend</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <!-- 程序附属文件(rg 二进制 / eagent-run.py)真源在仓库根 runtime/,不进 jar -->
                    <exclude>bin/**</exclude>
                    <exclude>eagent-run.py</exclude>
                    <exclude>__pycache__/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- worker 自身即启动模块:repackage 产出可执行 boot jar(合并原 every-agent-app 职责) -->
            <!-- classifier=exec:覆盖 parent 默认 repackage,可执行 jar 单独命名,原始 jar 保留供插件模块依赖 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.everyagent.worker.WorkerApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx1g -Xms256m -XX:TieredStopAtLevel=1 -XX:CICompilerCount=2 -XX:ReservedCodeCacheSize=64m -XX:CompressedClassSpaceSize=128m -Xss512k --add-opens java.base/sun.misc=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
