<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.everyagent</groupId>
        <artifactId>every-agent-parent</artifactId>
        <version>0.11.0</version>
    </parent>

    <groupId>dev.everyagent</groupId>
    <artifactId>every-agent-plugins</artifactId>
    <version>0.11.0</version>
    <packaging>pom</packaging>
    <name>every-agent-plugins</name>
    <description>内置插件父模块</description>

    <modules>
        <module>ai-review</module>
        <module>unattended</module>
        <module>git</module>
        <module>task-queue</module>
        <module>subagent</module>
        <module>task-input-queue</module>
        <module>task-edit-resend</module>
        <module>model-rate-limit</module>
        <module>empty-response-retry</module>
        <module>transient-error-retry</module>
        <module>context-compression</module>
        <module>model-pool</module>
        <module>model-length-guard</module>
        <module>adaptive-max-tokens</module>
        <module>system-info</module>
        <module>agents-md</module>
        <module>file-change</module>
        <module>sandbox-windows-mic</module>
        <module>sandbox-wsl-ubuntu</module>
    </modules>

    <build>
        <plugins>
            <!-- 将插件根目录的 plugin.json 复制到 classpath 根目录，供 PluginRegistry 扫描 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-manifest</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <includes>
                                        <include>plugin.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
