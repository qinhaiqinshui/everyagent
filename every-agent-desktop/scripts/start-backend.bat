@echo off
setlocal enabledelayedexpansion
rem ========================================================================
rem Every Agent worker standalone startup script
rem
rem Purpose : start the worker independently of the Desktop GUI (hub is still
rem           managed by desktop and is NOT started here).
rem           Fits the Windows Task Scheduler "at system startup" trigger
rem           (Session 0, no GUI). After startup the worker auto-connects to
rem           hub (localhost:6101); if hub is not up yet, the worker keeps
rem           retrying and connects automatically once desktop starts hub.
rem
rem Usage   : double-click / run from a console, or register in Task
rem           Scheduler with trigger "At log on" or "At system startup" (the
rem           latter needs highest privileges; having no GUI in Session 0 it
rem           only starts the worker process -- no Desktop window/tray, which
rem           is by design).
rem
rem Packaged location: <install root>\resources\start-backend.bat, alongside
rem jre\ backend\ runtime\ etc. (resourcesPath is the program root).
rem
rem IMPORTANT: keep this file ASCII-only. Under Session 0 / Task Scheduler,
rem cmd reads batch files with the OEM code page (e.g. CP936), not UTF-8; a
rem multi-byte character right before the line terminator can make cmd
rem swallow the CR, merging lines and executing comment fragments, which
rem broke the boot auto-start task with exit code 1 (observed regression).
rem ========================================================================

rem Program root = this script's dir (resourcesPath); explicitly injected
rem into the worker via -Deveryagent.program-dir.
rem NOTE: CWD must land in EVERYAGENT_HOME, never the install dir -- on
rem Windows a process' CWD directory cannot be deleted, and having the
rem install dir as CWD made uninstall/reinstall fail to remove the resources
rem directory (verified bug).
set "PROGRAM_DIR=%~dp0"

rem Set EVERYAGENT_HOME (default %USERPROFILE%\.everyagent)
if not defined EVERYAGENT_HOME set EVERYAGENT_HOME=%USERPROFILE%\.everyagent

rem Ensure log directory exists
if not exist "%EVERYAGENT_HOME%\logs" mkdir "%EVERYAGENT_HOME%\logs"

rem ------------------------------------------------------------------
rem  Worker connection credentials: reuse the
rem  <EVERYAGENT_HOME>\desktop\desktop-worker.yml generated by the desktop
rem  (security hardening: hubKey/workerApiKey in desktop-config.json are now
rem  stored DPAPI-encrypted with the 'safe:' prefix, bound to the current
rem  user and machine, so a script cannot decrypt them and the yml is no
rem  longer assembled here; the desktop main process decrypts them in memory
rem  and generates/refreshes this file before every backend launch, keeping
rem  worker and hub credentials in sync).
rem  If the file is missing, exit with error -- start the Every Agent desktop
rem  once to finish first-run key generation, then run this script again.
rem ------------------------------------------------------------------
set "WORKER_YML=%EVERYAGENT_HOME%\desktop\desktop-worker.yml"
if not exist "%WORKER_YML%" (
    echo [%date% %time%] "%WORKER_YML%" not found ^(desktop has not generated the credential file yet^)
    echo [%date% %time%] Please start the Every Agent desktop once to finish first-run key generation, then run this script again
    exit /b 1
)

rem Pick a Java executable: prefer the jlink runtime javaw.exe, fall back to
rem java.exe, then to the system java
set "JAVA_EXE=%PROGRAM_DIR%jre\bin\javaw.exe"
if not exist "%JAVA_EXE%" set "JAVA_EXE=%PROGRAM_DIR%jre\bin\java.exe"
if not exist "%JAVA_EXE%" set "JAVA_EXE=java"

set "WORKER_URL=http://127.0.0.1:6102/health"

rem ------------------------------------------------------------------
rem  Start worker
rem ------------------------------------------------------------------
echo [%date% %time%] Checking worker health...
call :check_http "%WORKER_URL%"
if !errorlevel! equ 0 (
    echo [%date% %time%] worker already running, skip start
) else (
    echo [%date% %time%] starting worker...
    cd /d "%EVERYAGENT_HOME%"
    start "" "%JAVA_EXE%" "-Deveryagent.program-dir=%PROGRAM_DIR%" -jar "%PROGRAM_DIR%backend\worker.jar" "--spring.config.additional-location=file:/%WORKER_YML:\=/%" 1>> "%EVERYAGENT_HOME%\logs\worker.out.log" 2>&1
)

rem Wait for worker readiness (health check + hub connected, up to 120s)
rem The worker retries the hub connection by itself; while hub is down,
rem hubConnected stays false and this script waits until hub is ready (hub
rem is expected to be started by desktop; the worker connects automatically).
set WORKER_WAIT=0
:wait_worker
call :check_worker_ready "%WORKER_URL%"
if !errorlevel! equ 0 goto worker_ready
set /a WORKER_WAIT+=1
if !WORKER_WAIT! geq 120 (
    echo [%date% %time%] timed out waiting for hub after 120s, worker is up but may not be connected to hub yet
    exit /b 0
)
timeout /t 1 /nobreak >nul
goto wait_worker
:worker_ready
echo [%date% %time%] worker ready ^(hub connected^)

echo [%date% %time%] worker startup complete
exit /b 0

rem ======================================================================
rem  Subroutine: check that the HTTP endpoint returns 200
rem  returns: errorlevel 0 = healthy, 1 = unreachable / non-200
rem ======================================================================
:check_http
powershell -NoProfile -Command "try { $r = Invoke-WebRequest -Uri '%~1' -TimeoutSec 3 -UseBasicParsing; if ($r.StatusCode -eq 200) { exit 0 } } catch {} exit 1"
goto :eof

rem ======================================================================
rem  Subroutine: worker readiness (health 200 and hubConnected=true)
rem  returns: errorlevel 0 = ready, 1 = not ready
rem ======================================================================
:check_worker_ready
powershell -NoProfile -Command "try { $r = Invoke-WebRequest -Uri '%~1' -TimeoutSec 3 -UseBasicParsing; $j = $r.Content | ConvertFrom-Json; if ($j.hubConnected -eq $true) { exit 0 } } catch {} exit 1"
goto :eof

