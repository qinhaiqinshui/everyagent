{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@every-agent/client": ["src/sdk/index.ts"],
      "@everyagent/plugin-api": ["../every-agent-plugin-api/js/index.ts"],
      "@plugins/*": ["../every-agent-plugins/*"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@ant-design/icons": ["./node_modules/@ant-design/icons/lib"],
      "antd": ["./node_modules/antd"],
      "antd/*": ["./node_modules/antd/*"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-markdown": ["./node_modules/react-markdown"],
      "remark-gfm": ["./node_modules/remark-gfm"]
    }
  },
  "include": ["src", "../every-agent-plugins/*/web"],
  "exclude": ["src/sdk/**/*.test.ts"]
}
