<?xml version="1.0" encoding="UTF-8"?>
<!-- ea: Maven 构建（仓库内形态：parent=插件 SDK parent every-agent-plugin-parent；插件不进根 reactor，须 mvn -f 单独构建） -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承插件 SDK parent（every-agent-plugin-parent）：Java 25 / 编码 / 依赖版本管理 /
         plugin.json 打包 / 测试栈全由它提供，本 pom 无须再声明。内置与外部插件共用同一份脚手架模板。 -->
    <parent>
        <groupId>io.github.qinhaiqinshui</groupId>
        <artifactId>every-agent-plugin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../every-agent-plugin-parent/pom.xml</relativePath>
    </parent>
    <version>0.1.0</version>

    <artifactId>ask-user</artifactId>
    <name>用户提问</name>
    <description>提供 ask_user 工具，支持向用户发起单选题提问并等待答复</description>


    <dependencies>
        <!-- 插件 API（编译期纯接口）。版本不在这里写：由根 pom 的 dependencyManagement 统一管理
             （= ${revision}）。注意不要写 ${project.version} —— 本工程自身版本与工程版本不同号
             （见本 pom 的 <version>），${project.version} 会被解析成本插件自己的版本。
             版本口径见根 pom 的 <revision> 单点源说明。 -->
        <dependency>
            <groupId>io.github.qinhaiqinshui</groupId>
            <artifactId>every-agent-plugin-api</artifactId>
        </dependency>
        <!-- Jackson: AskUserTool 容错反序列化（LenientString/List），版本随 parent（同 sandbox-wsl-ubuntu 写法） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
