<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.everyagent</groupId>
        <artifactId>every-agent-parent</artifactId>
        <version>0.11.0</version>
    </parent>

    <artifactId>every-agent-app</artifactId>
    <version>0.11.0</version>
    <name>every-agent-app</name>
    <description>worker 可执行启动模块（聚合 worker + 内置插件，打破循环依赖）</description>

    <dependencies>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-worker</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>ai-review</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>unattended</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>task-queue</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>subagent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>task-input-queue</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.everyagent.worker.WorkerApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
