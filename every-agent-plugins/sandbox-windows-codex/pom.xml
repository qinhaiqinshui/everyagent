<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.everyagent</groupId>
        <artifactId>every-agent-plugins</artifactId>
        <version>0.11.0</version>
    </parent>

    <artifactId>sandbox-windows-codex</artifactId>
    <name>sandbox-windows-codex</name>
    <description>Windows Codex 沙箱插件（双账户 + WRITE_RESTRICTED 受限令牌 + capability SID + WFP/防火墙）</description>

    <dependencies>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-plugin-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Windows 原生沙箱:JNA Win32 API + win 绑定层补齐原语（设计文档 §3） -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.16.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.16.0</version>
        </dependency>
        <!-- runner IPC 帧协议 JSON 编解码（设计文档 §2.7）；版本由 Spring Boot parent BOM 管理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
