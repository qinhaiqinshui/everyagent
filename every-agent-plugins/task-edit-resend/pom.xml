<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.everyagent</groupId>
        <artifactId>every-agent-plugin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../every-agent-plugin-parent/pom.xml</relativePath>
    </parent>
    <!-- 插件自身版本,与 plugin.json 的 version 同号,不随工程版本升级。
         集成测试(EditResendRoundsTest)以 test scope 依赖 worker 主 jar + test-jar,
         借用 worker 的宿主编排环境(FakeHub/FakeChatModel/TaskManager 等)做端到端验证。 -->
    <version>0.1.0</version>
    <artifactId>task-edit-resend</artifactId>
    <name>task-edit-resend</name>
    <description>编辑重发插件（edit.resend 节点 395.5：从 ctx.metadata 取 editSeq 截断磁盘/内存/会话后放行 consume.input）</description>


    <dependencies>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-contract</artifactId>
        </dependency>

        <!-- 集成测试宿主:worker 主 jar(普通 jar,classifier=exec 已把可执行 jar 分离) -->
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-worker</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <!-- worker 测试夹具(FakeHub / FakeChatModel / WsTestClient / TestCleanup) -->
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-worker</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- FakeHub 的 @ServerEndpoint 与测试的 ServerEndpointExporter 需要 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
