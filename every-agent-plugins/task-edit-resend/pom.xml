<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.everyagent</groupId>
        <artifactId>every-agent-plugin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../every-agent-plugin-parent/pom.xml</relativePath>
    </parent>
    <!-- 本插件是根 reactor 模块,且被 every-agent-worker 编译期依赖(EditResendRoundsTest 集成测试),
         因此不写自身 <version>,与工程版本 ${revision} 同号 —— 这是内置插件里唯一的例外。
         其余插件仅由 PluginLoader 运行时加载,各自持有自己的版本(与 plugin.json 的 version 同号)。 -->
    <artifactId>task-edit-resend</artifactId>
    <name>task-edit-resend</name>
    <description>编辑重发插件（edit.resend 节点 395.5：从 ctx.metadata 取 editSeq 截断磁盘/内存/会话后放行 consume.input）</description>


    <dependencies>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.everyagent</groupId>
            <artifactId>every-agent-contract</artifactId>
        </dependency>
    </dependencies>
</project>
