<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.qinhaiqinshui</groupId>
    <artifactId>every-agent-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>every-agent</name>
    <description>哪里都可以使用的 Agent —— worker 执行器 + hub 消息中心 + client SDK</description>

    <modules>
        <module>every-agent-contract</module>
        <module>every-agent-hub</module>
        <module>every-agent-plugin-parent</module>
        <module>every-agent-plugin-api</module>
        <module>every-agent-worker</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- 全仓唯一版本源（CI-friendly versions）：升级只改这一行。
             ① 各模块（contract/hub/worker/plugin-api 及根 reactor 内的插件）一律不写自身 <version>，继承本属性；
             ② 仅运行时加载的内置插件各自持有自己的版本（与它自己的 plugin.json 的 version 同号）；
             ③ 跨模块引用一律写 ${revision}，不要写 ${project.version} —— 后者解析的是「消费方自己」的版本，
                在插件（自身版本与工程版本不同号）里会静默指错坐标。 -->
        <revision>1.7.0</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.qinhaiqinshui</groupId>
                <artifactId>every-agent-contract</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.qinhaiqinshui</groupId>
                <artifactId>every-agent-plugin-api</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- CI-friendly versions 的官方搭配：install/deploy 用的 pom 把 ${revision} 解析成实际版本。
                 不加它的话，装进本地仓库/发布出去的 pom 里仍是 ${revision}，仓库外消费者（脚手架 standalone
                 工程、将来的 Maven Central 用户）解析 parent 会直接失败：
                 「Could not find artifact every-agent-parent:pom:${revision}」。
                 resolveCiFriendliesOnly：只解析 revision/sha1/changelist，其余内容原样保留。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 发布 Maven Central（维护者专用，见 CONTRIBUTING「发布（维护者）」）：
             mvn -Pcentral -pl every-agent-contract,every-agent-plugin-parent,every-agent-plugin-api -am deploy
             只发 SDK 链 4 坐标（-am 连带本聚合 pom = every-agent-parent）；hub / worker 不发布。
             Central Portal 要求：GPG 签名 + sources/javadoc jar（pom 打包模块自动跳过后两者）。
             本地无 GPG 密钥时验证构建可加 -Dgpg.skip=true。 -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <!-- 历史代码注释不满足严格 doclint，发布只要求 jar 存在，关闭 lint -->
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${gpg.skip}</skip>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Sonatype Central Portal 官方发布插件：收集 deploy 产物 + 签名并上传，
                         autoPublish 上传后自动放行；凭证经 settings.xml 的 server（id=central，
                         GitHub Actions 由 setup-java 注入，见 .github/workflows/publish-maven-central.yml）。 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <!-- 0.7.0 已知缺陷：Portal API 响应新增 warnings 字段后 Jackson 解析崩溃
                             （UnrecognizedPropertyException，v1.6.0 首发第 3 次触发），升 0.12.0（当前最新） -->
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
